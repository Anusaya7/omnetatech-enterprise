# OmNetaTech Enterprise — Production Environment Variables
# Copy this file to .env or configure directly in your hosting dashboard (Hostinger / Vercel).
# NEVER commit actual secret values to version control.

# Server & Runtime Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Persistent Database File Path (Optional - defaults to ./data/db.json)
DB_FILE_PATH=

# Administrator Credentials (Optional - overrides default credentials)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS Allowed Origins (Comma-separated list, e.g. https://omnetatech.com,https://www.omnetatech.com)
ALLOWED_ORIGINS=

# Frontend API URL (Optional - if frontend and API are hosted on different domains)
VITE_API_URL=
