# OmNetaTech Enterprise — environment example
# Copy to .env or set these in the Hostinger hPanel. Do not commit real secrets.
# SMTP_PASS must be a Gmail App Password, not the normal Gmail account password.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DB_FILE_PATH=

ADMIN_EMAIL=
ADMIN_PASSWORD=

ALLOWED_ORIGINS=https://omnetatech.com,https://www.omnetatech.com

VITE_API_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
